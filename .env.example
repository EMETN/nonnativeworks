# Copy to .env and fill in. Used by `pnpm dev:env` / `pnpm build:env`.
#
# Maintainers use Doppler instead (`pnpm dev`), which injects these as real
# environment variables. Both routes set the same names — see CONTRIBUTING.md.

# ─── Required ─────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API.
# Create a free project and run supabase/migrations/000_full_schema.sql in the
# SQL editor to get a working database.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# ─── Required for the admin area ──────────────────────────────────────────────
# Bypasses row-level security. Server-side only — never expose it to a browser.
# Public pages work without it; /admin, /api/admin, and /sitemap.xml do not.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional: batch scraping ─────────────────────────────────────────────────
# Shared secret letting scraper/batch_run.py call /api/admin/* without a session.
# Any long random string; must match on both sides. Only needed to run the
# batch job locally — the admin scraper UI uses your login instead.
SCRAPER_SECRET=

# Remote Chrome for the Playwright scraper. In the devcontainer, point this at a
# Chrome instance on the host started with --remote-debugging-port=9222.
# See scraper/SCRAPING.md.
PLAYWRIGHT_CDP_URL=

# ─── Optional: analytics and error tracking ───────────────────────────────────
# All unset by default. The app runs fine without them — PostHog and Sentry
# simply stay disabled.
PUBLIC_POSTHOG_KEY=
PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Build-time source map upload only. Leave blank for local development.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
