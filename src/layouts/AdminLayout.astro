---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import PublishButton from '../components/admin/PublishButton.tsx';
import BackToTop from '../components/shared/BackToTop.astro';
import { readLocalDataEpoch } from '../../scripts/local-data-epoch.mjs';

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;

const scraperEnabled = import.meta.env.NETLIFY !== 'true';
const navItems = [
    ...(scraperEnabled ? [{ href: '/admin/scrape', label: 'Scrape' }] : []),
    { href: '/admin/companies', label: 'Companies' },
    { href: '/admin/positions', label: 'Positions' },
    { href: '/admin/skills', label: 'Skills' },
];
const path = Astro.url.pathname;
const localDataEpoch = import.meta.env.DEV ? readLocalDataEpoch() : undefined;
---

<!doctype html>
<html lang="en" data-local-data-epoch={localDataEpoch}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} — Admin — nonnativeworks!</title>
        <meta name="robots" content="noindex, nofollow" />
        <ClientRouter />
    </head>
    <body class="bg-gray-50 min-h-screen">
        <div class="sticky top-0 z-30">
            <header class="bg-white border-b border-gray-200">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center justify-between h-14">
                        <div class="flex items-center gap-4">
                            <a
                                href="/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-500 hover:text-gray-900 text-sm"
                            >
                                ← Public site
                                <span class="sr-only">
                                    {' '}
                                    (opens in a new tab)
                                </span>
                            </a>
                            <span class="text-gray-500">|</span>
                            <span class="font-semibold text-gray-900">
                                Dashboard
                            </span>
                        </div>
                        <div class="flex items-center gap-4">
                            <PublishButton client:load />
                            <form
                                method="POST"
                                action="/api/auth/signout"
                                data-astro-reload
                            >
                                <button
                                    type="submit"
                                    class="text-sm text-gray-500 hover:text-gray-900 cursor-pointer"
                                >
                                    Sign out
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <nav
                class="bg-white border-b border-gray-200"
                aria-label="Admin sections"
            >
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-1 overflow-x-auto overflow-y-hidden">
                    {navItems.map((item) => {
                        const active = path === item.href;
                        return (
                            <a
                                href={item.href}
                                aria-current={active ? 'page' : undefined}
                                class={`px-4 py-3 text-sm font-medium border-b-2 -mb-px whitespace-nowrap transition-colors ${
                                    active
                                        ? 'border-gray-900 text-gray-900'
                                        : 'border-transparent text-gray-500 hover:text-gray-700'
                                }`}
                            >
                                {item.label}
                            </a>
                        );
                    })}
                </div>
            </nav>
        </div>

        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-gray-900">{title}</h1>
                {description && (
                    <p class="text-sm text-gray-500 mt-1 max-w-3xl">
                        {description}
                    </p>
                )}
            </div>
            <slot />
        </main>

        <BackToTop />
    </body>
</html>

<style is:global>
    html {
        overflow-y: scroll;
    }

    /* Height of the sticky header + nav; table headers stick just below it */
    body {
        --admin-sticky-top: 6.25rem;
    }
    .sticky-head thead th {
        position: sticky;
        top: var(--admin-sticky-top);
        z-index: 10;
        background-color: #f9fafb;
        box-shadow: inset 0 -1px 0 #e5e7eb;
    }
</style>
