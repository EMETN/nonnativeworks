---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
interface BreadcrumbItem {
    name: string;
    href?: string;
}

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    noindex?: boolean;
    breadcrumbs?: BreadcrumbItem[];
}

const {
    title,
    description = 'Find companies where English is enough — browse positions by country.',
    ogImage,
    noindex = false,
    breadcrumbs,
} = Astro.props;

const siteTitle =
    title === 'Home'
        ? 'NonNativeWorks — Work abroad in English'
        : `${title} — NonNativeWorks`;

const canonical = Astro.url.href;
const ogImageUrl = ogImage ?? `${Astro.url.origin}/og-default.png`;
---

<!doctype html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{siteTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={siteTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="NonNativeWorks" />
        {ogImage && <meta property="og:image" content={ogImageUrl} />}

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={siteTitle} />
        <meta name="twitter:description" content={description} />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        {breadcrumbs && breadcrumbs.length > 0 && (
            <script type="application/ld+json" set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": breadcrumbs.map((item, i) => ({
                    "@type": "ListItem",
                    "position": i + 1,
                    "name": item.name,
                    ...(item.href ? { "item": new URL(item.href, Astro.url.origin).href } : {}),
                })),
            })} />
        )}

        <!-- Self-hosted Inter variable font — preload to avoid swap flicker -->
        <link
            rel="preload"
            href={interLatinWoff2}
            as="font"
            type="font/woff2"
            crossorigin
        />
        <ClientRouter />
    </head>
    <body class="flex flex-col overflow-x-hidden" style="min-height: 100vh; min-height: 100dvh;">
        {import.meta.env.PUBLIC_POSTHOG_KEY && (
            <script is:inline define:vars={{ posthogKey: import.meta.env.PUBLIC_POSTHOG_KEY }}>
                (function() {
                    var origin = window.location.origin;
                    var isDev = window.location.hostname === 'localhost';
                    var s = document.createElement('script');
                    s.src = isDev
                        ? '/node_modules/posthog-js/dist/array.full.js'
                        : origin + '/ph-events/static/array.full.js';
                    s.onload = function() {
                        window.posthog.init(posthogKey, {
                            api_host: origin + '/ph-events',
                            ui_host: origin + '/ph-static',
                            autocapture: true,
                            capture_pageview: true,
                            capture_pageleave: false,
                            request_batching: true,
                            advanced_disable_flags: true,
                            disable_external_dependency_loading: isDev,
                            disable_session_recording: isDev,
                            capture_dead_clicks: !isDev,
                            capture_performance: !isDev,
                            debug: false,
                        });
                    };
                    document.head.appendChild(s);
                    if (!window.__phNavInit) {
                        window.__phNavInit = true;
                        document.addEventListener('astro:page-load', function() {
                            if (window.posthog) window.posthog.capture('$pageview');
                        });
                    }
                })();
            </script>
        )}
        <!-- Skip to content (accessibility) -->
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:text-[#0B5E3C] focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg focus:font-medium focus:text-sm focus:outline-none focus:ring-2 focus:ring-[#12956B]"
        >
            Skip to content
        </a>

        <Header />
        <main id="main-content" class="flex-1 flex flex-col">
            <slot />
        </main>
        <Footer />
    </body>
</html>
