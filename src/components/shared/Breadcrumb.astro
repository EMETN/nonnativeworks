---
interface BreadcrumbItem {
    label: string;
    href?: string;
}

interface Props {
    items: BreadcrumbItem[];
    id?: string;
    class?: string;
}

const { items, id, class: className } = Astro.props;
---

<nav
    id={id}
    class:list={['text-sm text-gray-500 mb-2 md:mb-4', className]}
    aria-label="Breadcrumb"
>
    <ol
        class="flex items-center breadcrumb-list"
        style="list-style:none;padding:0;margin:0"
    >
        {
            items.map((item, i) => {
                const isLast = i === items.length - 1;
                return (
                    <li
                        aria-current={isLast ? 'page' : undefined}
                        class={isLast ? 'text-gray-900 font-medium' : ''}
                    >
                        {item.href && !isLast ? (
                            <a
                                href={item.href}
                                data-astro-prefetch
                                class="hover:text-gray-700 transition-colors"
                            >
                                {item.label}
                            </a>
                        ) : (
                            item.label
                        )}
                    </li>
                );
            })
        }
    </ol>
</nav>
