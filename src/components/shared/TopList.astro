---
interface ListItem {
    href: string;
    name: string;
    english: number;
    total: number;
    pct: number;
    flag?: string;
}

interface Props {
    title: string;
    items: ListItem[];
    seeAllHref?: string;
    seeAllLabel?: string;
}

const { title, items, seeAllHref, seeAllLabel } = Astro.props;
const numFont = "font-family: 'Inter', 'Inter Fallback', sans-serif;";
---

<div>
    <h2
        class="text-base sm:text-lg md:text-base lg:text-xl font-semibold uppercase tracking-wider text-gray-900 mb-5 text-center"
    >
        {title}
    </h2>
    <div class="hover-fade-list hover-fade-soft flex flex-col">
        {
            items.map((item, i) => (
                <a
                    href={item.href}
                    class="hover-fade-item flex items-center gap-3 sm:gap-5 py-3.5 sm:py-4 border-b border-gray-100 last:border-b-0 rounded-lg px-0 md:px-3 md:-mx-3"
                >
                    <span class="text-xl md:text-lg lg:text-2xl font-bold text-gray-300">
                        {i + 1}
                    </span>
                    {item.flag && (
                        <span class="w-[1.875rem] md:w-[1.6875rem] lg:w-[2.25rem] inline-flex items-center justify-center shrink-0">
                            <img
                                src={item.flag}
                                alt=""
                                class="h-[1.25rem] md:h-[1.125rem] lg:h-[1.5rem] w-auto shadow-[0_1px_3px_rgba(0,0,0,0.15)]"
                            />
                        </span>
                    )}
                    <div class="flex-1 min-w-0">
                        <span class="text-xl md:text-lg lg:text-2xl font-semibold text-gray-900 truncate block">
                            {item.name}
                        </span>
                    </div>
                    <div
                        class="flex items-center shrink-0 tabular-nums"
                        style={numFont}
                    >
                        <span class="text-xl md:text-lg lg:text-2xl font-bold text-[#0F7A4F] text-right min-w-[2rem] md:min-w-[1.75rem] lg:min-w-[2.5rem]">
                            {item.english}
                        </span>
                        <span class="text-sm md:text-xs lg:text-base text-gray-500 mx-0.5">
                            /
                        </span>
                        <span class="text-sm md:text-xs lg:text-base text-gray-500">
                            {item.total}
                        </span>
                    </div>
                    <svg
                        class="w-4 h-4 md:w-3.5 md:h-3.5 lg:w-5 lg:h-5 text-gray-300 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 5l7 7-7 7"
                        />
                    </svg>
                </a>
            ))
        }
    </div>
    {seeAllHref && seeAllLabel && (
        <div class="flex justify-center mt-5">
            <a
                href={seeAllHref}
                class="text-sm sm:text-base font-medium text-gray-900 border border-gray-200 hover:border-gray-400 px-5 py-2 rounded-lg transition-colors"
                >{seeAllLabel}</a
            >
        </div>
    )}
</div>

