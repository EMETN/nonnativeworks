---
interface Props {
    kind: 'company' | 'country';
    class?: string;
}

const TALLY_FORMS = {
    company: 'https://tally.so/r/xXb80y',
    country: 'https://tally.so/r/xXb80o',
} as const;

const { kind, class: className } = Astro.props;
---

<a
    href={TALLY_FORMS[kind]}
    target="_blank"
    rel="noopener noreferrer"
    class:list={['btn', className]}
>
    Suggest a {kind}
    <span class="sr-only"> (opens in a new tab)</span>
</a>
