---

<header
    class="bg-white border-b border-gray-200 sticky top-0 z-50"
    role="banner"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <a
                href="/"
                class="flex items-center gap-2"
                aria-label="NonNativeWorks — home"
            >
                <span class="text-xl font-bold text-gray-900" aria-hidden="true"
                    >NonNativeWorks</span
                >
            </a>
            <nav class="flex items-center gap-1 sm:gap-2" aria-label="Main navigation">
                <a
                    href="/countries"
                    class="text-sm font-medium text-gray-500 hover:text-gray-900 px-2.5 py-1.5 rounded-md hover:bg-gray-100 transition-colors"
                    >Countries</a
                >
                <a
                    href="/companies"
                    class="text-sm font-medium text-gray-500 hover:text-gray-900 px-2.5 py-1.5 rounded-md hover:bg-gray-100 transition-colors"
                    >Companies</a
                >
            </nav>
        </div>
    </div>
</header>
