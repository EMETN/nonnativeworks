---
const pathname = Astro.url.pathname;
const segments = pathname.replace(/\/$/, '').split('/').filter(Boolean);
const isHome = pathname === '/';
const isAdmin = pathname.startsWith('/admin');
const isCountryCompany =
    segments.length >= 2 &&
    segments[0] !== 'companies' &&
    segments[0] !== 'admin';
const isCompanies =
    pathname === '/companies' ||
    pathname.startsWith('/companies/') ||
    isCountryCompany;
const isCountries = !isHome && !isCompanies && !isAdmin;
---

<header
    class="bg-white border-b border-gray-200 sticky top-0 z-50"
    role="banner"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <a
                href="/"
                class="flex items-center gap-2"
                aria-label="NonNativeWorks — home"
            >
                <span class="text-xl font-bold text-gray-900" aria-hidden="true"
                    >NonNativeWorks</span
                >
            </a>

            <!-- Desktop nav -->
            <nav
                class="hidden sm:flex items-center gap-2"
                aria-label="Main navigation"
            >
                <a
                    href="/countries"
                    class={`text-sm font-medium px-2.5 py-1.5 rounded-md transition-colors ${isCountries ? 'text-[#0F7A4F]' : 'text-gray-900 hover:bg-gray-100'}`}
                    aria-current={isCountries ? 'true' : undefined}>Countries</a
                >
                <a
                    href="/companies"
                    class={`text-sm font-medium px-2.5 py-1.5 rounded-md transition-colors ${isCompanies ? 'text-[#0F7A4F]' : 'text-gray-900 hover:bg-gray-100'}`}
                    aria-current={isCompanies ? 'true' : undefined}>Companies</a
                >
            </nav>

            <!-- Mobile hamburger -->
            <button
                id="mobile-menu-btn"
                class="sm:hidden p-2 rounded-md text-gray-900 hover:bg-gray-100 transition-colors"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        id="hamburger-icon"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                    <path
                        id="close-icon"
                        class="hidden"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile menu panel -->
    <div
        id="mobile-menu"
        class="sm:hidden absolute left-0 right-0 top-full border-t border-gray-200 bg-white shadow-lg mobile-menu-panel"
        aria-hidden="true"
    >
        <nav aria-label="Mobile navigation" class="mobile-menu-inner">
        <div class="px-4 py-3 space-y-1">
            <a
                href="/countries"
                class={`block text-base font-medium px-3 py-2 rounded-md transition-colors ${isCountries ? 'text-[#0F7A4F]' : 'text-gray-900 hover:bg-gray-100'}`}
                aria-current={isCountries ? 'true' : undefined}>Countries</a
            >
            <a
                href="/companies"
                class={`block text-base font-medium px-3 py-2 rounded-md transition-colors ${isCompanies ? 'text-[#0F7A4F]' : 'text-gray-900 hover:bg-gray-100'}`}
                aria-current={isCompanies ? 'true' : undefined}>Companies</a
            >
        </div>
        </nav>
    </div>
</header>

<script>
    function initMobileMenu() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const hamburger = document.getElementById('hamburger-icon');
        const close = document.getElementById('close-icon');
        if (!btn || !menu || !hamburger || !close) return;

        function toggle(open: boolean) {
            menu!.classList.toggle('is-open', open);
            menu!.setAttribute('aria-hidden', String(!open));
            btn!.setAttribute('aria-expanded', String(open));
            hamburger!.classList.toggle('hidden', open);
            close!.classList.toggle('hidden', !open);
        }

        btn.addEventListener('click', () => {
            toggle(!menu.classList.contains('is-open'));
        });
    }

    initMobileMenu();
    document.addEventListener('astro:after-swap', initMobileMenu);

    document.addEventListener('click', (e) => {
        const menu = document.getElementById('mobile-menu');
        const btn = document.getElementById('mobile-menu-btn');
        if (
            menu && btn &&
            menu.classList.contains('is-open') &&
            !menu.contains(e.target as Node) &&
            !btn.contains(e.target as Node)
        ) {
            menu.classList.remove('is-open');
            menu.setAttribute('aria-hidden', 'true');
            btn.setAttribute('aria-expanded', 'false');
            document.getElementById('hamburger-icon')?.classList.remove('hidden');
            document.getElementById('close-icon')?.classList.add('hidden');
        }
    });

    window.addEventListener(
        'scroll',
        () => {
            const menu = document.getElementById('mobile-menu');
            if (menu?.classList.contains('is-open')) {
                menu.classList.remove('is-open');
                menu.setAttribute('aria-hidden', 'true');
                document.getElementById('mobile-menu-btn')?.setAttribute('aria-expanded', 'false');
                document.getElementById('hamburger-icon')?.classList.remove('hidden');
                document.getElementById('close-icon')?.classList.add('hidden');
            }
        },
        { passive: true },
    );
</script>
