---
import type { GlobalStats } from '../lib/types';

interface Props {
  stats?: GlobalStats;
}

const { stats } = Astro.props;
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50" role="banner">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2" aria-label="NonNativeWorks — home">
        <span class="text-xl font-bold text-gray-900" aria-hidden="true">NonNativeWorks</span>
      </a>

      {stats && stats.total_positions > 0 && (
        <div
          class="flex items-center gap-2 sm:gap-3"
          aria-label={`${stats.total_positions} positions tracked, ${stats.english_percentage}% non-native`}
        >
          <div class="text-right whitespace-nowrap" aria-hidden="true">
            <div class="text-[0.5rem] sm:text-xs font-semibold tracking-wider uppercase text-gray-500 leading-tight">Positions</div>
            <div class="text-sm sm:text-xl font-bold text-gray-900 leading-tight">{stats.total_positions.toLocaleString()}</div>
          </div>
          <div class="text-right whitespace-nowrap border-l border-gray-200 pl-2 sm:pl-3" aria-hidden="true">
            <div class="text-[0.5rem] sm:text-xs font-semibold tracking-wider uppercase text-gray-500 leading-tight">Non-native</div>
            <div class="text-sm sm:text-xl font-bold text-blue-600 leading-tight">{stats.english_percentage}%</div>
          </div>
        </div>
      )}
    </div>
  </div>
</header>
