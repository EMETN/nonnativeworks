---
interface Props {
  percentage: number;
  code: string;
}

const { percentage, code } = Astro.props;
const pct = Math.max(0, Math.min(100, Math.round(percentage)));
const lowerCode = code.toLowerCase();
const flagUrl = `/flags/${lowerCode}.svg`;
const clipTop = 100 - pct;
const textTop = Math.max(8, Math.min(92, clipTop));
---

<div class="shrink-0 flex">
  {/* Flag + line */}
  <div class="relative w-[70px] sm:w-[90px] md:w-[150px] shrink-0">
    <div class="overflow-hidden shadow-md border border-gray-200/50 relative bg-gray-100">
      <img
        src={flagUrl}
        alt=""
        class="w-full block grayscale opacity-35"
        loading="eager"
        decoding="async"
      />
      {pct > 0 && (
        <img
          src={flagUrl}
          alt=""
          class="absolute inset-0 w-full h-full object-cover"
          style={`clip-path: inset(${clipTop}% 0 0 0);`}
          loading="eager"
          decoding="async"
        />
      )}
    </div>

    {/* Line — slightly wider than flag, same color as greyed-out flag background */}
    {pct > 0 && pct < 100 && (
      <div
        class="absolute -left-2 -right-2 sm:-left-3 sm:-right-3 h-[2px] bg-gray-300 -translate-y-1/2 z-10"
        style={`top: ${clipTop}%;`}
      />
    )}
  </div>

  {/* Percentage — in flow so it's always visible, stretches to flag height for alignment */}
  <div class="relative w-10 sm:w-12 md:w-16">
    <span
      class="absolute left-2.5 sm:left-3.5 md:left-5 -translate-y-1/2 text-[10px] sm:text-xs md:text-sm font-bold text-gray-700 whitespace-nowrap"
      style={`top: ${textTop}%; font-family: 'Inter', 'Inter Fallback', sans-serif;`}
    >
      {pct}%
    </span>
  </div>
</div>
