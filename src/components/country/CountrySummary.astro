---
import type { CountryStats } from '../../lib/types';

interface Props {
  country: CountryStats;
  companyCount: number;
}

const { country, companyCount } = Astro.props;
const pct = Math.round(country.english_percentage);
const numFont = "font-family: 'Inter', 'Inter Fallback', sans-serif";
---

<div class="flex flex-wrap items-baseline gap-x-4 sm:gap-x-6 gap-y-2 mb-10">
  <div class="flex items-baseline gap-1 sm:gap-2">
    <span class="text-xl sm:text-5xl font-bold text-gray-900" style={numFont}>{companyCount}</span>
    <span class="text-[0.6rem] sm:text-sm font-semibold tracking-wider uppercase text-gray-400">companies</span>
  </div>
  <span class="text-base sm:text-3xl font-light text-gray-300">|</span>
  <div class="flex items-baseline gap-1 sm:gap-2">
    <span class="text-xl sm:text-5xl font-bold text-[#0F7A4F]" style={numFont}>{country.english_positions.toLocaleString()}</span>
    <span class="text-xl sm:text-5xl font-light text-gray-300">/</span>
    <span class="text-xl sm:text-5xl font-bold text-gray-900" style={numFont}>{country.total_positions.toLocaleString()}</span>
    <span class="text-[0.6rem] sm:text-sm font-semibold tracking-wider uppercase text-gray-400">positions</span>
  </div>
</div>
