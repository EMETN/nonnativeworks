---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfographicGrid from '../components/infographic/InfographicGrid.tsx';
import StatsDescription from '../components/shared/StatsDescription.astro';
import { getCountryStats, getCompanyCountsByCountry } from '../lib/queries';
import type { CountryStats } from '../lib/types';

let countries: CountryStats[] = [];
let companyCounts: Record<string, number> = {};
let loadError = false;

try {
  const [allCountries, cc] = await Promise.all([
    getCountryStats(Astro.request, Astro.cookies),
    getCompanyCountsByCountry(Astro.request, Astro.cookies),
  ]);
  countries = allCountries.filter((c) => c.total_positions > 0);
  companyCounts = cc;
} catch (err) {
  console.error('Homepage data load error:', err);
  loadError = true;
}

const totalPositions = countries.reduce((s, c) => s + c.total_positions, 0);
const englishPositions = countries.reduce((s, c) => s + c.english_positions, 0);
const totalCompanies = Object.values(companyCounts).reduce((s, n) => s + n, 0);
---

<BaseLayout
  title="Home"
  description="NonNativeWorks tracks open positions where English is enough — no local language required. Browse by country to find your next opportunity abroad."
>
  <div class="max-w-screen-lg w-full mx-auto px-4 sm:px-6 lg:px-12 pt-8 sm:pt-12">
    <!-- Intro -->
    <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-16">
      <h1 class="text-3xl sm:text-4xl md:text-6xl font-bold mb-4 leading-tight">
        <span class="text-gray-900">No native language?</span><br />
        <span class="text-[#002EA2]">NonNativeWorks!</span>
      </h1>
      <p class="text-base sm:text-lg text-gray-500 max-w-xl mx-auto">
        Discover companies that welcome non-native language speakers.
        Track open positions across countries worldwide.
      </p>
    </div>
  </div>

  <!-- Country list — full width, same margins as header -->
  <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    {loadError ? (
      <div class="text-center py-8 text-gray-400">
        <p class="text-lg mb-2">Something went wrong loading the data.</p>
        <p class="text-sm">Please try again later.</p>
      </div>
    ) : countries.length === 0 ? (
      <div class="text-center py-8 text-gray-400">
        <p class="text-lg mb-2">No positions tracked yet.</p>
        <p class="text-sm">Check back soon — we're adding new countries and companies regularly.</p>
      </div>
    ) : (
      <StatsDescription>
        Tracking <strong class="font-semibold text-gray-700">{totalPositions.toLocaleString()}</strong> {totalPositions === 1 ? 'position' : 'positions'} — <strong class="font-semibold text-gray-700">{englishPositions.toLocaleString()}</strong> English-friendly — across <strong class="font-semibold text-gray-700">{totalCompanies.toLocaleString()}</strong> {totalCompanies === 1 ? 'company' : 'companies'} in <strong class="font-semibold text-gray-700">{countries.length}</strong> {countries.length === 1 ? 'country' : 'countries'}.
      </StatsDescription>
      <InfographicGrid countries={countries} companyCounts={companyCounts} client:load />
    )}
  </div>
</BaseLayout>
