---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Scraper from '../../components/admin/Scraper.tsx';
import DataManager from '../../components/admin/DataManager.tsx';
import PositionEditor from '../../components/admin/PositionEditor.tsx';
import SkillsManager from '../../components/admin/SkillsManager.tsx';

// The scraper requires a local Python subprocess and only works in dev.
// Hide the tab entirely in production (Netlify) to avoid confusion.
const scraperEnabled = import.meta.env.NETLIFY !== 'true';
const defaultTab = scraperEnabled ? 'scraper' : 'companies';
---

<AdminLayout title="Dashboard">
  <!-- Top-level tab bar -->
  <div class="flex gap-1 border-b border-gray-200 mb-6" role="tablist">
    {scraperEnabled && (
      <button
        id="tab-btn-scraper"
        role="tab"
        aria-selected="true"
        aria-controls="tab-panel-scraper"
        class="tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-b-0 border-gray-200 bg-white text-blue-600 -mb-px"
      >
        Scrape
      </button>
    )}
    <button
      id="tab-btn-companies"
      role="tab"
      aria-selected={!scraperEnabled}
      aria-controls="tab-panel-companies"
      class={`tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border ${!scraperEnabled ? 'border-gray-200 bg-white text-blue-600 border-b-0 -mb-px' : 'border-transparent text-gray-500 hover:text-gray-700'}`}
    >
      Companies
    </button>
    <button
      id="tab-btn-positions"
      role="tab"
      aria-selected="false"
      aria-controls="tab-panel-positions"
      class="tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-transparent text-gray-500 hover:text-gray-700"
    >
      Positions
    </button>
    <button
      id="tab-btn-skills"
      role="tab"
      aria-selected="false"
      aria-controls="tab-panel-skills"
      class="tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-transparent text-gray-500 hover:text-gray-700"
    >
      Skills
    </button>
  </div>

  <!-- Scrape tab (dev only) -->
  {scraperEnabled && (
    <div id="tab-panel-scraper" role="tabpanel">
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-gray-900">Scrape</h2>
        <p class="text-sm text-gray-500 mt-1">
          Enter a career page URL. Supported ATS platforms (Greenhouse, Lever, Ashby, Workable)
          are fetched directly via their API. Other pages are scraped via the Python scraper.
          Review and adjust the results before uploading.
        </p>
        <p class="text-xs text-amber-600 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 mt-2 inline-block">
          Dev only — production scraping runs automatically via the GitHub Actions scheduled job.
        </p>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-5">
        <Scraper client:load />
      </div>
    </div>
  )}

  <!-- Companies tab -->
  <div id="tab-panel-companies" role="tabpanel" class={scraperEnabled ? 'hidden' : ''}>
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Companies</h2>
      <p class="text-sm text-gray-500 mt-1">
        View all tracked companies. Deleting a company removes all its positions too.
      </p>
    </div>
    <DataManager client:load />
  </div>

  <!-- Positions tab -->
  <div id="tab-panel-positions" role="tabpanel" class="hidden">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Positions</h2>
      <p class="text-sm text-gray-500 mt-1">
        Correct category or language requirements for already-uploaded positions.
        Changes take effect immediately.
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl p-5">
      <PositionEditor client:load />
    </div>
  </div>

  <!-- Skills tab -->
  <div id="tab-panel-skills" role="tabpanel" class="hidden">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Skills</h2>
      <p class="text-sm text-gray-500 mt-1">
        Manage the skills taxonomy used for extraction and keyword search.
        Aliases are matched against job descriptions during scraping — changes take effect on the next scrape run.
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl p-5">
      <SkillsManager client:load />
    </div>
  </div>
</AdminLayout>

<script is:inline define:vars={{ defaultTab }}>
  const ALL_TABS = ['scraper', 'companies', 'positions', 'skills'];

  function activateTab(target) {
    ALL_TABS.forEach((name) => {
      const btn = document.getElementById(`tab-btn-${name}`);
      const panel = document.getElementById(`tab-panel-${name}`);
      const isActive = name === target;

      if (btn) {
        btn.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          btn.classList.add('border-gray-200', 'bg-white', 'text-blue-600', '-mb-px');
          btn.classList.remove('border-transparent', 'text-gray-500', 'hover:text-gray-700');
        } else {
          btn.classList.remove('border-gray-200', 'bg-white', 'text-blue-600', '-mb-px');
          btn.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700');
        }
      }
      if (panel) {
        panel.classList.toggle('hidden', !isActive);
      }
    });
  }

  // Wire up all tab buttons
  ALL_TABS.forEach((name) => {
    document.getElementById(`tab-btn-${name}`)?.addEventListener('click', () => activateTab(name));
  });

  // Restore tab from sessionStorage (e.g. after DataManager "Update" triggers scraper)
  const stored = sessionStorage.getItem('admin-active-tab');
  if (stored && ALL_TABS.includes(stored)) {
    activateTab(stored);
    sessionStorage.removeItem('admin-active-tab');
  }
</script>
