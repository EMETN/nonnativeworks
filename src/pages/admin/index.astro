---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Scraper from '../../components/admin/Scraper.tsx';
import PromptGenerator from '../../components/admin/PromptGenerator.tsx';
import JsonUploader from '../../components/admin/JsonUploader.tsx';
import DataManager from '../../components/admin/DataManager.tsx';
---

<AdminLayout title="Dashboard">
  <div class="space-y-10">

    <!-- Step 1: Add data (tabbed) -->
    <section>
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-gray-900">1. Add company data</h2>
        <p class="text-sm text-gray-500 mt-1">
          Use the scraper for automatic extraction, or generate a prompt to run through an LLM manually.
        </p>
      </div>

      <!-- Tab buttons -->
      <div class="flex gap-1 border-b border-gray-200 mb-5" role="tablist">
        <button
          id="tab-btn-scraper"
          role="tab"
          aria-selected="true"
          aria-controls="tab-panel-scraper"
          class="tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-b-0 border-gray-200 bg-white text-blue-600 -mb-px"
        >
          Scraper
        </button>
        <button
          id="tab-btn-manual"
          role="tab"
          aria-selected="false"
          aria-controls="tab-panel-manual"
          class="tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-transparent text-gray-500 hover:text-gray-700"
        >
          Manual (LLM prompt)
        </button>
      </div>

      <!-- Scraper tab -->
      <div id="tab-panel-scraper" role="tabpanel">
        <div class="bg-white border border-gray-200 rounded-xl p-5">
          <p class="text-sm text-gray-500 mb-4">
            Enter a career page URL. Supported ATS platforms (Greenhouse, Lever) are fetched
            directly via their API. Other pages are scraped via the Python scraper if configured.
            Review and adjust the results before uploading.
          </p>
          <Scraper client:load />
        </div>
      </div>

      <!-- Manual tab -->
      <div id="tab-panel-manual" role="tabpanel" class="hidden">
        <div class="space-y-8">
          <div>
            <div class="mb-3">
              <h3 class="text-sm font-semibold text-gray-800">Generate extraction prompt</h3>
              <p class="text-xs text-gray-500 mt-0.5">
                Enter a career page URL to generate a prompt. Paste it into your LLM of choice
                and it will return structured JSON ready to upload below.
              </p>
            </div>
            <div class="bg-white border border-gray-200 rounded-xl p-5">
              <PromptGenerator client:load />
            </div>
          </div>

          <div>
            <div class="mb-3">
              <h3 class="text-sm font-semibold text-gray-800">Upload JSON output</h3>
              <p class="text-xs text-gray-500 mt-0.5">
                Paste the LLM's JSON response or load a <code class="text-xs bg-gray-100 px-1 rounded">.json</code> file.
                Validate first, then upload — existing positions for that company will be replaced.
              </p>
            </div>
            <div class="bg-white border border-gray-200 rounded-xl p-5">
              <JsonUploader client:load />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Step 2: Manage data -->
    <section>
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-gray-900">2. Manage data</h2>
        <p class="text-sm text-gray-500 mt-1">
          View all tracked companies. Deleting a company removes all its positions too.
        </p>
      </div>
      <DataManager client:load />
    </section>

  </div>
</AdminLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = {
    scraper: document.getElementById('tab-panel-scraper')!,
    manual: document.getElementById('tab-panel-manual')!,
  };

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.id === 'tab-btn-scraper' ? 'scraper' : 'manual';

      buttons.forEach((b) => {
        const active = b.id === btn.id;
        b.setAttribute('aria-selected', String(active));
        if (active) {
          b.classList.add('border-gray-200', 'bg-white', 'text-blue-600', '-mb-px');
          b.classList.remove('border-transparent', 'text-gray-500', 'hover:text-gray-700');
        } else {
          b.classList.remove('border-gray-200', 'bg-white', 'text-blue-600', '-mb-px');
          b.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700');
        }
      });

      panels.scraper.classList.toggle('hidden', target !== 'scraper');
      panels.manual.classList.toggle('hidden', target !== 'manual');
    });
  });
</script>
