---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex hideNavActive>
    <div
        class="flex flex-col items-center justify-center flex-1 px-4 sm:px-6 lg:px-8"
    >
        <div class="flex items-end mb-4 sm:mb-8">
            <div class="flex flex-col items-end pr-2.5 sm:pr-3 md:pr-4">
                <span
                    class="text-[0.45rem] sm:text-xs font-semibold tracking-wider uppercase text-gray-500 mb-0.5"
                >
                    Error
                </span>
                <span
                    class="text-4xl sm:text-7xl font-bold text-gray-900 leading-none tabular-nums"
                    style="font-family: 'Inter', 'Inter Fallback', sans-serif;"
                >
                    404
                </span>
            </div>
            <div class="flex items-end gap-0.5 sm:gap-1 pl-2 sm:pl-4 md:pl-6">
                <span
                    class="text-4xl sm:text-7xl font-bold text-[#C0392B] leading-none tabular-nums"
                    style="font-family: 'Inter', 'Inter Fallback', sans-serif;"
                >
                    0
                </span>
                <span
                    class="text-4xl sm:text-7xl font-light text-gray-500 leading-none"
                    aria-hidden="true">/</span
                >
                <div class="flex flex-col items-end">
                    <span
                        class="text-[0.45rem] sm:text-xs font-semibold tracking-wider uppercase text-gray-500 mb-0.5"
                    >
                        Pages
                    </span>
                    <span
                        class="text-4xl sm:text-7xl text-gray-500 leading-none tabular-nums"
                        style="font-family: 'Inter', 'Inter Fallback', sans-serif;"
                    >
                        0
                    </span>
                </div>
            </div>
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">
            Lost in translation
        </h1>
        <p
            class="text-sm sm:text-lg text-gray-500 mb-8 max-w-[14rem] sm:max-w-md text-center"
        >
            This page doesn't exist — but plenty of jobs do.<br />
            Head back and find your next opportunity.
        </p>
        <a
            href="/countries"
            class="inline-block text-sm sm:text-base font-medium text-gray-500 border border-gray-500 hover:text-[#0F7A4F] hover:border-[#0F7A4F] px-5 py-2 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#12956B] focus-visible:ring-offset-2"
        >
            Browse countries
        </a>
    </div>
</BaseLayout>
