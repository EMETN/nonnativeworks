---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyGauge from '../../components/company/CompanyGauge.astro';
import CompanyCountryGrid from '../../components/company/CompanyCountryGrid.tsx';
import StatsDescription from '../../components/shared/StatsDescription.astro';
import { getGlobalCompanyBySlug } from '../../lib/queries';
import { nameToSlug } from '../../lib/country-flags';

const { company: companySlug } = Astro.params;
const { request, cookies } = Astro;

const company = await getGlobalCompanyBySlug(request, cookies, companySlug!);

if (!company) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
}

const entries = company.entries.map((e) => ({
    country_name: e.country_name,
    country_slug: e.country_slug,
    country_code: e.country_code,
    english_positions: e.english_positions,
    total_positions: e.total_positions,
}));
---

<BaseLayout
    title={`${company.name}`}
    description={`${company.name} has ${company.total_positions} open positions across ${company.entries.length} ${company.entries.length === 1 ? 'country' : 'countries'} — ${company.english_positions} don't require the local language(s).`}
    breadcrumbs={[
        { name: 'Home', href: '/' },
        { name: 'Companies', href: '/companies' },
        { name: company.name },
    ]}
>
    <div
        class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-12 pb-16"
    >
        <nav class="text-sm text-gray-400 mb-2 md:mb-4" aria-label="Breadcrumb">
            <a
                href="/"
                data-astro-prefetch
                class="hover:text-gray-700 transition-colors">Home</a
            >
            <span class="mx-1.5">›</span>
            <a
                href="/companies"
                data-astro-prefetch
                class="hover:text-gray-700 transition-colors">Companies</a
            >
            <span class="mx-1.5">›</span>
            <span class="text-gray-900 font-medium">{company.name}</span>
        </nav>

        <div class="flex items-center justify-between gap-4 sm:gap-6 mb-2 sm:mb-6 sm:pr-8 md:pr-12 xl:pr-18">
            <h1
                class="text-4xl sm:text-4xl md:text-6xl font-bold text-gray-900 leading-tight"
                style="font-family: 'Inter', 'Inter Fallback', sans-serif;"
            >
                {company.name}
                {
                    company.is_english_company && (
                        <span class="text-sm sm:text-base bg-[#C2E0D1] text-[#0B5E3C] px-2 py-1 rounded font-semibold align-middle ml-2">
                            EN
                        </span>
                    )
                }
            </h1>
            {company.total_positions > 0 && (
                <CompanyGauge
                    englishPositions={company.english_positions}
                    totalPositions={company.total_positions}
                />
            )}
        </div>

        {
            company.total_positions > 0 && (
                <StatsDescription>
                    <strong class="font-semibold text-gray-900">
                        {company.english_positions.toLocaleString()}
                    </strong>{' '}
                    of{' '}
                    <strong class="font-semibold text-gray-900">
                        {company.total_positions.toLocaleString()}
                    </strong>{' '}
                    open{' '}
                    {company.total_positions === 1 ? 'position' : 'positions'}{' '}
                    across{' '}
                    <strong class="font-semibold text-gray-900">
                        {company.entries.length}
                    </strong>{' '}
                    {company.entries.length === 1 ? 'country' : 'countries'}{' '}
                    {company.english_positions === 1 ? "doesn't" : "don't"}{' '}
                    require the local language(s).
                </StatsDescription>
            )
        }
        {
            company.total_positions === 0 ? (
                <div class="text-center py-16 text-gray-400">
                    No positions tracked yet for <strong>{company.name}</strong>.
                    Check back soon!
                </div>
            ) : (
                <>
                    <CompanyCountryGrid
                        entries={entries}
                        companySlug={companySlug!}
                        client:visible
                    />
                    <p class="text-xs sm:text-sm text-gray-400 mt-4">
                        Updated{' '}
                        {new Date(company.updated_at).toLocaleDateString(
                            'en-GB',
                            {
                                day: 'numeric',
                                month: 'short',
                                year: 'numeric',
                            },
                        )}
                    </p>
                </>
            )
        }
    </div>
    <script is:inline define:vars={{ companySlug: companySlug! }}>
        sessionStorage.setItem('nav-from-company', companySlug);
    </script>
</BaseLayout>
