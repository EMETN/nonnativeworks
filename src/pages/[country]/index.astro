---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyGrid from '../../components/country/CompanyGrid.tsx';
import CompanyGauge from '../../components/company/CompanyGauge.astro';
import StatsDescription from '../../components/shared/StatsDescription.astro';
import { getCountryBySlug, getCompanyStatsByCountry } from '../../lib/queries';

const { country: slug } = Astro.params;
const { request, cookies } = Astro;

const country = await getCountryBySlug(request, cookies, slug!);

if (!country) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
}

const companies = await getCompanyStatsByCountry(
    request,
    cookies,
    country.country_id,
);
---

<BaseLayout
    title={country.name}
    description={`Browse ${country.total_positions} open positions in ${country.name} — ${country.english_positions} can be done in English without knowing the local language.`}
    breadcrumbs={[
        { name: 'Home', href: '/' },
        { name: 'Countries', href: '/countries' },
        { name: country.name },
    ]}
>
    <div
        class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-12 pb-16"
    >
        <!-- Breadcrumb -->
        <nav class="text-sm text-gray-400 mb-2 md:mb-4" aria-label="Breadcrumb">
            <a
                href="/"
                data-astro-prefetch
                class="hover:text-gray-700 transition-colors">Home</a
            >
            <span class="mx-1.5">›</span>
            <a
                href="/countries"
                data-astro-prefetch
                class="hover:text-gray-700 transition-colors">Countries</a
            >
            <span class="mx-1.5">›</span>
            <span class="text-gray-900 font-medium">{country.name}</span>
        </nav>

        <!-- Title + Gauge -->
        <div
            class="flex items-center justify-between gap-4 sm:gap-6 mb-2 sm:mb-6 sm:pr-8 md:pr-12 xl:pr-18"
        >
            <h1
                class="flex items-center gap-2 sm:gap-3 md:gap-4 text-4xl sm:text-4xl md:text-6xl font-bold text-gray-900 leading-tight"
                style="font-family: 'Inter', 'Inter Fallback', sans-serif;"
            >
                {country.name}
                <img
                    src={`/flags/${country.code.toLowerCase()}.png`}
                    alt={`${country.name} flag`}
                    class="h-[1.4rem] sm:h-[1.4rem] md:h-[2.1rem] w-auto shadow-[0_1px_3px_rgba(0,0,0,0.15)]"
                />
            </h1>
            {
                country.total_positions > 0 && (
                    <CompanyGauge
                        englishPositions={country.english_positions}
                        totalPositions={country.total_positions}
                    />
                )
            }
        </div>

        {
            companies.length > 0 && (
                <StatsDescription>
                    <strong class="font-semibold text-gray-900">
                        {companies.length}
                    </strong>{' '}
                    {companies.length === 1 ? 'company' : 'companies'} —{' '}
                    <strong class="font-semibold text-gray-900">
                        {country.english_positions.toLocaleString()}
                    </strong>{' '}
                    of{' '}
                    <strong class="font-semibold text-gray-900">
                        {country.total_positions.toLocaleString()}
                    </strong>{' '}
                    open{' '}
                    {country.total_positions === 1 ? 'position' : 'positions'}{' '}
                    {country.english_positions === 1 ? "doesn't" : "don't"}{' '}
                    require the local language(s).
                </StatsDescription>
            )
        }
        {
            companies.length === 0 ? (
                <div class="text-center py-16 text-gray-400">
                    No companies tracked yet for <strong>{country.name}</strong>
                    . Check back soon!
                </div>
            ) : (
                <CompanyGrid
                    companies={companies}
                    countrySlug={country.slug}
                    client:visible
                />
            )
        }
    </div>
</BaseLayout>
