---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CountrySummary from '../../components/country/CountrySummary.astro';
import CompanyGrid from '../../components/country/CompanyGrid.tsx';
import {
  getCountryBySlug,
  getCompanyStatsByCountry,
  getGlobalStats,
} from '../../lib/queries';

const { country: slug } = Astro.params;
const { request, cookies } = Astro;

const [stats, country] = await Promise.all([
  getGlobalStats(request, cookies),
  getCountryBySlug(request, cookies, slug!),
]);

if (!country) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const companies = await getCompanyStatsByCountry(request, cookies, country.country_id);
---

<BaseLayout
  title={country.name}
  description={`Browse ${country.total_positions} open positions in ${country.name} — ${country.english_positions} can be done in English without knowing the local language.`}
  stats={stats}
>
  <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-12 pb-16">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-400 mb-2 md:mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-700 transition-colors">Home</a>
      <span class="mx-1.5">›</span>
      <span class="text-gray-900 font-medium">{country.name}</span>
    </nav>

    <!-- Title -->
    <h1 class="text-3xl sm:text-4xl md:text-6xl font-bold text-gray-900 mb-2 sm:mb-6 leading-tight" style="font-family: 'Inter', 'Inter Fallback', sans-serif;">
      {country.name}
    </h1>

    <!-- Summary stats -->
    <CountrySummary country={country} companyCount={companies.length} />

    <!-- Company grid -->
    {companies.length === 0 ? (
      <div class="text-center py-16 text-gray-400">
        No companies tracked yet for <strong>{country.name}</strong>. Check back soon!
      </div>
    ) : (
      <CompanyGrid companies={companies} countrySlug={country.slug} client:load />
    )}
  </div>
</BaseLayout>
