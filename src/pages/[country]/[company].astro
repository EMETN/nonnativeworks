---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBreakdown from '../../components/country/CategoryBreakdown.astro';
import PositionList from '../../components/company/PositionList.tsx';
import {
  getCountryBySlug,
  getCompanyBySlugInCountry,
  getPositionsByCompany,
  getCategoryBreakdownByCompany,
  getGlobalStats,
} from '../../lib/queries';

const { country: countrySlug, company: companySlug } = Astro.params;
const { request, cookies } = Astro;

const [stats, country] = await Promise.all([
  getGlobalStats(request, cookies),
  getCountryBySlug(request, cookies, countrySlug!),
]);

if (!country) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const company = await getCompanyBySlugInCountry(request, cookies, country.country_id, companySlug!);

if (!company) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const [positions, categories] = await Promise.all([
  getPositionsByCompany(request, cookies, company.company_id),
  getCategoryBreakdownByCompany(request, cookies, company.company_id),
]);

const numFont = "font-family: 'Inter', 'Inter Fallback', sans-serif";
---

<BaseLayout
  title={`${company.name} — ${country.name}`}
  description={`${company.name} has ${company.total_positions} open positions in ${country.name} — ${company.english_positions} don't require the local language.`}
  stats={stats}
>
  <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 pb-16">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-400 mb-4 md:mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-700 transition-colors">Home</a>
      <span class="mx-1.5">›</span>
      <a href={`/${country.slug}`} class="hover:text-gray-700 transition-colors">{country.name}</a>
      <span class="mx-1.5">›</span>
      <span class="text-gray-900 font-medium">{company.name}</span>
    </nav>

    <!-- Title -->
    <h1 class="text-3xl sm:text-4xl md:text-6xl font-bold text-gray-900 mb-2 sm:mb-6 leading-tight" style={numFont}>
      {company.name}
      {company.is_english_company && (
        <span class="text-sm sm:text-base bg-[#CCd9ED] text-[#002383] px-2 py-1 rounded font-semibold align-middle ml-2">
          EN
        </span>
      )}
    </h1>

    <!-- Summary stats -->
    <div class="flex flex-wrap items-baseline gap-x-4 sm:gap-x-6 gap-y-2 mb-10">
      <div class="flex items-baseline gap-1 sm:gap-2">
        <span class="text-xl sm:text-5xl font-bold text-[#002EA2]" style={numFont}>{company.english_positions.toLocaleString()}</span>
        <span class="text-[0.6rem] sm:text-sm font-semibold tracking-wider uppercase text-gray-400">non-native</span>
      </div>
      <span class="text-base sm:text-3xl font-light text-gray-300">/</span>
      <div class="flex items-baseline gap-1 sm:gap-2">
        <span class="text-xl sm:text-5xl font-bold text-gray-900" style={numFont}>{company.total_positions.toLocaleString()}</span>
        <span class="text-[0.6rem] sm:text-sm font-semibold tracking-wider uppercase text-gray-400">total</span>
      </div>
      <span class="text-base sm:text-3xl font-light text-gray-300">/</span>
      <div class="flex items-baseline gap-1 sm:gap-2">
        <span class="text-xl sm:text-5xl font-bold text-gray-900" style={numFont}>{Math.round(company.english_percentage)}%</span>
      </div>
    </div>

    <!-- Position list (Preact island) -->
    {positions.length === 0 ? (
      <div class="text-center py-16 text-gray-400">
        No positions tracked yet for <strong>{company.name}</strong>. Check back soon!
      </div>
    ) : (
      <PositionList positions={positions} careerPageUrl={company.career_page_url} client:load />
    )}

    <!-- Category breakdown -->
    <CategoryBreakdown categories={categories} />

  </div>
</BaseLayout>
