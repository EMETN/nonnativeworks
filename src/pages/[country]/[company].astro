---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PositionList from '../../components/company/PositionList.tsx';
import StatsDescription from '../../components/shared/StatsDescription.astro';
import {
    getCountryBySlug,
    getCompanyBySlugInCountry,
    getPositionsByCompany,
} from '../../lib/queries';

const { country: countrySlug, company: companySlug } = Astro.params;
const { request, cookies } = Astro;

const country = await getCountryBySlug(request, cookies, countrySlug!);

if (!country) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
}

const company = await getCompanyBySlugInCountry(
    request,
    cookies,
    country.country_id,
    companySlug!,
);

if (!company) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
}

const positions = await getPositionsByCompany(
    request,
    cookies,
    company.company_id,
);
---

<BaseLayout
    title={`${company.name} — ${country.name}`}
    description={`${company.name} has ${company.total_positions} open positions in ${country.name} — ${company.english_positions} don't require the local language(s).`}
>
    <div
        class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-12 pb-16"
    >
        <!-- Breadcrumb -->
        <nav class="text-sm text-gray-400 mb-2 md:mb-4" aria-label="Breadcrumb">
            <a
                href="/"
                data-astro-prefetch
                class="hover:text-gray-700 transition-colors">Home</a
            >
            <span class="mx-1.5">›</span>
            <a
                href={`/${country.slug}`}
                data-astro-prefetch
                class="hover:text-gray-700 transition-colors">{country.name}</a
            >
            <span class="mx-1.5">›</span>
            <span class="text-gray-900 font-medium">{company.name}</span>
        </nav>

        <!-- Title -->
        <h1
            class="text-3xl sm:text-4xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight"
        >
            {company.name}
            {
                company.is_english_company && (
                    <span class="text-sm sm:text-base bg-[#dcfce7] text-[#14532d] px-2 py-1 rounded font-semibold align-middle ml-2">
                        EN
                    </span>
                )
            }
        </h1>

        <!-- Position list (Preact island) -->
        {
            positions.length > 0 && (
                <StatsDescription>
                    <strong class="font-semibold text-gray-900">
                        {company.english_positions.toLocaleString()}
                    </strong>{' '}
                    of{' '}
                    <strong class="font-semibold text-gray-900">
                        {company.total_positions.toLocaleString()}
                    </strong>{' '}
                    {company.total_positions === 1 ? 'position' : 'positions'} at{' '}
                    {company.name}{' '}
                    {company.english_positions === 1 ? "doesn't" : "don't"} require
                    the local language(s).
                </StatsDescription>
            )
        }
        {
            positions.length === 0 ? (
                <div class="text-center py-16 text-gray-400">
                    No positions tracked yet for <strong>{company.name}</strong>
                    . Check back soon!
                </div>
            ) : (
                <>
                    <PositionList
                        positions={positions}
                        careerPageUrl={company.career_page_url}
                        client:visible
                    />
                    <p class="text-xs sm:text-sm text-gray-400 mt-4">
                        Updated{' '}
                        {new Date(company.updated_at).toLocaleDateString(
                            'en-GB',
                            {
                                day: 'numeric',
                                month: 'short',
                                year: 'numeric',
                            },
                        )}
                    </p>
                </>
            )
        }
    </div>
</BaseLayout>
