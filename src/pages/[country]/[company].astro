---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyGauge from '../../components/company/CompanyGauge.astro';
import PositionList from '../../components/company/PositionList.tsx';
import StatsDescription from '../../components/shared/StatsDescription.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import {
    getCountryBySlug,
    getCompanyBySlugInCountry,
    getPositionsByCompany,
} from '../../lib/queries';

const { country: countrySlug, company: companySlug } = Astro.params;
const { request, cookies } = Astro;

const country = await getCountryBySlug(request, cookies, countrySlug!);

if (!country) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
}

const company = await getCompanyBySlugInCountry(
    request,
    cookies,
    country.country_id,
    companySlug!,
);

if (!company) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
}

const positions = await getPositionsByCompany(
    request,
    cookies,
    company.company_id,
);

---

<BaseLayout
    title={`${company.name} — ${country.name}`}
    description={`${company.name} has ${company.total_positions} open positions in ${country.name} — ${company.english_positions} don't require the local language(s).`}
    breadcrumbs={[
        { name: 'Home', href: '/' },
        { name: 'Countries', href: '/countries' },
        { name: country.name, href: `/${country.slug}` },
        { name: company.name },
    ]}
>
    <div
        class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-12 pb-16"
    >
        <Breadcrumb
            id="breadcrumb-country"
            items={[
                { label: 'Home', href: '/' },
                { label: 'Countries', href: '/countries' },
                { label: country.name, href: `/${country.slug}` },
                { label: company.name },
            ]}
        />
        <Breadcrumb
            id="breadcrumb-company"
            class="hidden"
            items={[
                { label: 'Home', href: '/' },
                { label: 'Companies', href: '/companies' },
                { label: company.name, href: `/companies/${companySlug}` },
                { label: country.name },
            ]}
        />

        <!-- Title + Gauge -->
        <div class="flex items-center justify-between gap-4 sm:gap-6 mb-2 sm:mb-6 sm:pr-8 md:pr-12 xl:pr-18">
            <h1
                class="text-4xl sm:text-4xl md:text-6xl font-bold text-gray-900 leading-tight"
                style="font-family: 'Inter', 'Inter Fallback', sans-serif;"
            >
                {company.name}
            </h1>
            {company.total_positions > 0 && (
                <CompanyGauge
                    englishPositions={company.english_positions}
                    totalPositions={company.total_positions}
                />
            )}
        </div>

        {
            positions.length > 0 && (
                <StatsDescription>
                    <strong class="font-semibold text-gray-900">
                        {company.english_positions.toLocaleString()}
                    </strong>{' '}
                    of{' '}
                    <strong class="font-semibold text-gray-900">
                        {company.total_positions.toLocaleString()}
                    </strong>{' '}
                    open{' '}
                    {company.total_positions === 1 ? 'position' : 'positions'}{' '}
                    at {company.name}{' '}
                    {company.english_positions === 1 ? "doesn't" : "don't"}{' '}
                    require the local language(s).
                </StatsDescription>
            )
        }
        {
            positions.length === 0 ? (
                <div class="text-center py-16 text-gray-500">
                    <p>No positions tracked yet for <strong>{company.name}</strong>. Check back soon!</p>
                    <a href={`/${countrySlug}`} class="inline-block mt-4 text-sm font-medium text-[#0F7A4F] hover:underline">Browse other companies in {country.name}</a>
                </div>
            ) : (
                <>
                    <PositionList
                        positions={positions}
                        careerPageUrl={company.career_page_url}
                        client:visible
                    />
                    <p class="text-xs sm:text-sm text-gray-500 mt-4">
                        Updated{' '}
                        {new Date(company.updated_at).toLocaleDateString(
                            'en-GB',
                            {
                                day: 'numeric',
                                month: 'short',
                                year: 'numeric',
                            },
                        )}
                    </p>
                </>
            )
        }
    </div>
    <script is:inline>
        const fromCompany = sessionStorage.getItem('nav-from-company');
        if (fromCompany) {
            document.getElementById('breadcrumb-country').classList.add('hidden');
            document.getElementById('breadcrumb-company').classList.remove('hidden');
            sessionStorage.removeItem('nav-from-company');
        }
    </script>
</BaseLayout>
