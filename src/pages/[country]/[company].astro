---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyGauge from '../../components/company/CompanyGauge.astro';
import PositionList from '../../components/company/PositionList.tsx';
import StatsDescription from '../../components/shared/StatsDescription.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import { getCountryStats } from '../../lib/queries';
import {
    fetchAllCompanyStats,
    fetchAllPositions,
    groupBy,
} from '../../lib/build-queries';
import { nameToSlug } from '../../lib/country-flags';
import { timeAgo } from '../../lib/time';
import { cleanPathname } from '../../lib/url-path';
import type {
    CountryStats,
    CompanyStats,
    PositionDetail,
} from '../../lib/types';

export async function getStaticPaths() {
    const [countries, allCompanyStats, allPositions] = await Promise.all([
        getCountryStats(undefined, undefined),
        fetchAllCompanyStats(),
        fetchAllPositions(),
    ]);

    const countriesById = new Map(countries.map((c) => [c.country_id, c]));
    const positionsByCompany = groupBy(allPositions, (row) => row.company_id);

    return allCompanyStats.flatMap((company) => {
        const country = countriesById.get(company.country_id);
        if (!country) return [];

        return [
            {
                params: {
                    country: country.slug,
                    company: nameToSlug(company.name),
                },
                props: {
                    country,
                    company,
                    positions: positionsByCompany.get(company.company_id) ?? [],
                },
            },
        ];
    });
}

interface Props {
    country: CountryStats;
    company: CompanyStats;
    positions: PositionDetail[];
}

const { country, company, positions } = Astro.props as Props;
const { country: countrySlug, company: companySlug } = Astro.params;

// Query params prefill matching hidden fields in the Tally report form.
const cleanUrl = new URL(cleanPathname(Astro.url), Astro.url).href;
const reportUrl =
    `https://tally.so/r/MeZWEl?company=${encodeURIComponent(company.name)}` +
    `&country=${encodeURIComponent(country.name)}` +
    `&url=${encodeURIComponent(cleanUrl)}`;
---

<BaseLayout
    title={`${company.name} — ${country.name}`}
    description={`${company.name} has ${company.total_positions} open positions in ${country.name} — ${company.english_positions} don't require the local language(s).`}
    breadcrumbs={[
        { name: 'Home', href: '/' },
        { name: 'Countries', href: '/countries' },
        { name: country.name, href: `/${country.slug}` },
        { name: company.name },
    ]}
>
    <div
        class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-12 pb-16"
    >
        <Breadcrumb
            id="breadcrumb-country"
            items={[
                { label: 'Home', href: '/' },
                { label: 'Countries', href: '/countries' },
                { label: country.name, href: `/${country.slug}` },
                { label: company.name },
            ]}
        />
        <Breadcrumb
            id="breadcrumb-company"
            class="hidden"
            items={[
                { label: 'Home', href: '/' },
                { label: 'Companies', href: '/companies' },
                { label: company.name, href: `/companies/${companySlug}` },
                { label: country.name },
            ]}
        />

        <!-- Title + Gauge -->
        <div
            class="flex items-center justify-between gap-4 sm:gap-6 mb-2 sm:mb-6 sm:pr-8 md:pr-12 xl:pr-18"
        >
            <h1
                class="text-4xl sm:text-4xl md:text-6xl font-bold text-gray-900 leading-tight"
                style="font-family: 'Inter', 'Inter Fallback', sans-serif;"
            >
                {company.name}
            </h1>
            {
                company.total_positions > 0 && (
                    <CompanyGauge
                        englishPositions={company.english_positions}
                        totalPositions={company.total_positions}
                    />
                )
            }
        </div>

        {
            positions.length > 0 && (
                <StatsDescription>
                    <strong class="font-semibold text-gray-900">
                        {company.english_positions.toLocaleString()}
                    </strong>{' '}
                    of{' '}
                    <strong class="font-semibold text-gray-900">
                        {company.total_positions.toLocaleString()}
                    </strong>{' '}
                    open{' '}
                    {company.total_positions === 1 ? 'position' : 'positions'}{' '}
                    at {company.name}{' '}
                    {company.english_positions === 1 ? "doesn't" : "don't"}{' '}
                    require the local language(s).
                </StatsDescription>
            )
        }
        {
            positions.length === 0 ? (
                <div class="text-center py-16 text-gray-500">
                    <p>
                        No positions tracked yet for{' '}
                        <strong>{company.name}</strong>. Check back soon!
                    </p>
                    <a
                        href={`/${countrySlug}`}
                        class="inline-block mt-4 text-sm font-medium text-[#0F7A4F] hover:underline"
                    >
                        Browse other companies in {country.name}
                    </a>
                </div>
            ) : (
                <>
                    <PositionList
                        positions={positions}
                        careerPageUrl={company.career_page_url}
                        reportUrl={reportUrl}
                        client:idle
                    />
                    <p
                        class="text-xs sm:text-sm text-gray-500 mt-4"
                        title={new Date(company.updated_at).toLocaleDateString(
                            'en-GB',
                            { day: 'numeric', month: 'short', year: 'numeric' },
                        )}
                    >
                        Updated {timeAgo(company.updated_at)}
                    </p>
                </>
            )
        }
    </div>
    <script is:inline>
        const fromCompany = sessionStorage.getItem('nav-from-company');
        if (fromCompany) {
            document
                .getElementById('breadcrumb-country')
                .classList.add('hidden');
            document
                .getElementById('breadcrumb-company')
                .classList.remove('hidden');
            sessionStorage.removeItem('nav-from-company');
        }
    </script>
</BaseLayout>
