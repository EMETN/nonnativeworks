---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfographicGrid from '../components/infographic/InfographicGrid.tsx';
import CompanyGauge from '../components/company/CompanyGauge.astro';
import StatsDescription from '../components/shared/StatsDescription.astro';
import Breadcrumb from '../components/shared/Breadcrumb.astro';
import SuggestCta from '../components/shared/SuggestCta.astro';
import {
    getCountryStats,
    getCompanyCountsByCountry,
    getGlobalStats,
} from '../lib/queries';
import type { CountryStats } from '../lib/types';

const [allCountries, companyCounts, stats] = await Promise.all([
    getCountryStats(undefined, undefined),
    getCompanyCountsByCountry(undefined, undefined),
    getGlobalStats(undefined, undefined),
]);
const countries: CountryStats[] = allCountries.filter(
    (c) => c.total_positions > 0,
);

const totalPositions = stats.total_positions;
const englishPositions = stats.english_positions;
---

<BaseLayout
    title="Countries"
    description="Browse all countries with English-friendly job positions — no local language required."
    breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Countries' }]}
>
    <div
        class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-12 pb-16"
        data-list-page
    >
        <Breadcrumb
            items={[{ label: 'Home', href: '/' }, { label: 'Countries' }]}
        />

        <div class="flex items-center justify-between gap-4 sm:gap-6 mb-2 sm:mb-6 sm:pr-8 md:pr-12 xl:pr-18">
            <h1
                class="text-4xl sm:text-4xl md:text-6xl font-bold text-gray-900 leading-tight"
                style="font-family: 'Inter', 'Inter Fallback', sans-serif;"
            >
                Countries
            </h1>
            {totalPositions > 0 && (
                <CompanyGauge
                    englishPositions={englishPositions}
                    totalPositions={totalPositions}
                />
            )}
        </div>

        {countries.length === 0 ? (
            <div class="text-center py-16 text-gray-500">
                <p>No countries tracked yet. Check back soon!</p>
                <SuggestCta kind="country" class="mt-6" />
            </div>
        ) : (
            <>
                <StatsDescription>
                    <strong class="font-semibold text-gray-900">
                        {countries.length}
                    </strong>{' '}
                    {countries.length === 1 ? 'country' : 'countries'} —{' '}
                    <strong class="font-semibold text-gray-900">
                        {englishPositions.toLocaleString()}
                    </strong>{' '}
                    of{' '}
                    <strong class="font-semibold text-gray-900">
                        {totalPositions.toLocaleString()}
                    </strong>{' '}
                    open {totalPositions === 1 ? 'position' : 'positions'}{' '}
                    {englishPositions === 1 ? "doesn't" : "don't"} require the
                    local language(s).
                </StatsDescription>
                <InfographicGrid
                    countries={countries}
                    companyCounts={companyCounts}
                    client:idle
                />
                <div class="mt-6 text-center suggest-cta">
                    <SuggestCta kind="country" />
                </div>
            </>
        )}
    </div>
</BaseLayout>
