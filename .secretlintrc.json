{
    "rules": [
        {
            "id": "@secretlint/secretlint-rule-preset-recommend"
        },
        {
            "id": "@secretlint/secretlint-rule-pattern",
            "options": {
                "patterns": [
                    {
                        "name": "Supabase key (legacy JWT anon/service_role)",
                        "pattern": "/eyJhbGciOi[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}/g"
                    },
                    {
                        "name": "Supabase secret key",
                        "pattern": "/sb_secret_[A-Za-z0-9_-]{16,}/g"
                    },
                    {
                        "name": "Supabase publishable key",
                        "pattern": "/sb_publishable_[A-Za-z0-9_-]{16,}/g"
                    },
                    {
                        "name": "Doppler token",
                        "pattern": "/dp\\.(st|pt|sa|ct|scim|audit)\\.([A-Za-z0-9_-]+\\.)?[A-Za-z0-9_-]{20,}/g"
                    },
                    {
                        "name": "Sentry auth token",
                        "pattern": "/sntrys_[A-Za-z0-9_.\\-=]{20,}/g"
                    },
                    {
                        "name": "PostHog personal API key",
                        "pattern": "/phx_[A-Za-z0-9]{32,}/g"
                    }
                ]
            }
        }
    ]
}
