{
    "name": "nonnativeworks",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "dev": "doppler run -- env NODE_OPTIONS='--dns-result-order=ipv4first' astro dev --host",
        "build": "astro build",
        "preview": "doppler run -- astro preview",
        "astro": "astro",
        "postinstall": "node scripts/patch-preact-vite.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf node_modules dist pnpm-lock.yaml .pnpm-store .netlify"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.8",
        "@astrojs/netlify": "^7.0.8",
        "@astrojs/node": "^10.0.6",
        "@astrojs/preact": "^5.1.2",
        "@fontsource-variable/inter": "^5.2.8",
        "@preact/preset-vite": "^2.10.5",
        "@sentry/astro": "^10.50.0",
        "@sentry/browser": "^10.50.0",
        "@sentry/node": "^10.50.0",
        "@supabase/ssr": "^0.10.2",
        "@supabase/supabase-js": "^2.105.0",
        "@tailwindcss/vite": "^4.2.4",
        "astro": "^6.1.9",
        "posthog-js": "^1.372.3",
        "preact": "^10.29.1",
        "tailwindcss": "^4.2.4",
        "tinyld": "^1.3.4",
        "typescript": "^6.0.3",
        "zod": "^4.3.6"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp"
        ]
    },
    "devDependencies": {
        "vitest": "^4.1.5"
    }
}
