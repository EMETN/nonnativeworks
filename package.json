{
    "name": "nonnativeworks",
    "type": "module",
    "version": "0.0.1",
    "license": "CC-BY-NC-SA-4.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@11.20.0",
    "scripts": {
        "dev": "doppler run -- env NODE_OPTIONS='--dns-result-order=ipv4first' astro dev --host",
        "build": "astro build",
        "preview": "doppler run -- astro preview",
        "astro": "astro",
        "postinstall": "node scripts/patch-preact-vite.mjs && simple-git-hooks",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:py": "ruff format scraper",
        "lint:py": "ruff check scraper"
    },
    "simple-git-hooks": {
        "pre-commit": "npx --no-install lint-staged"
    },
    "lint-staged": {
        "*.{ts,tsx,astro,js,mjs,json,yaml,yml,md}": "prettier --write",
        "scraper/**/*.py": "ruff format"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/netlify": "^8.2.0",
        "@astrojs/node": "^11.1.0",
        "@astrojs/preact": "^6.0.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@preact/preset-vite": "^2.10.6",
        "@sentry/astro": "^10.69.0",
        "@sentry/browser": "^10.69.0",
        "@sentry/node": "^10.69.0",
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.112.2",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.2.0",
        "posthog-js": "^1.413.3",
        "preact": "^10.29.8",
        "tailwindcss": "^4.3.3",
        "tinyld": "^1.3.4",
        "typescript": "^7.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "simple-git-hooks": "^2.13.1",
        "vitest": "^4.1.10"
    }
}
