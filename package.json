{
    "name": "nonnativeworks",
    "type": "module",
    "version": "0.0.1",
    "license": "CC-BY-NC-SA-4.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@11.17.0",
    "scripts": {
        "dev": "doppler run -- env NODE_OPTIONS='--dns-result-order=ipv4first' astro dev --host",
        "build": "astro build",
        "preview": "doppler run -- astro preview",
        "astro": "astro",
        "postinstall": "node scripts/patch-preact-vite.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clean": "rm -rf node_modules dist .pnpm-store .netlify"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/netlify": "^8.1.2",
        "@astrojs/node": "^11.0.2",
        "@astrojs/preact": "^6.0.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@preact/preset-vite": "^2.10.6",
        "@sentry/astro": "^10.68.0",
        "@sentry/browser": "^10.68.0",
        "@sentry/node": "^10.68.0",
        "@supabase/ssr": "^0.12.3",
        "@supabase/supabase-js": "^2.110.9",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.1.4",
        "posthog-js": "^1.407.3",
        "preact": "^10.29.7",
        "tailwindcss": "^4.3.3",
        "tinyld": "^1.3.4",
        "typescript": "^7.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "vitest": "^4.1.10"
    }
}
